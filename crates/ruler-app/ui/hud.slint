// Arknights Cost Bar Ruler ??HUD overlay
// Cold / sharp / minimal. Timer is the hero; cost frame is a quiet secondary cluster.
// Rendered by the software renderer into a per-pixel-alpha layered window.
// All user-facing strings are localized in Rust and pushed in as properties.

import { Palette, Icons, IconBtn, Chip } from "theme.slint";

// Secondary surfaces live in their own files; re-export so `include_modules!`
// exposes them to Rust alongside `Hud`.
export { RulerMenu, ProfileRow } from "menu.slint";
export { Wizard, TargetRow } from "wizard.slint";
export { AxesPanel, AxisRow } from "axes.slint";

export enum HudMode {
    booting,
    idle,
    precal,
    calibrating,
    running,
    error,
}

export component Hud inherits Window {
    // ---- inputs (driven from Rust each tick) ----
    in property <HudMode> mode: HudMode.booting;
    in property <string> time-str: "00:00:00";
    in property <string> frame-str: "--";
    in property <string> total-str: "/--";
    in property <string> lap-str: "";
    in property <bool> cost-negative: false;
    in property <float> progress: 0;          // 0..100 during calibration
    in property <string> progress-str: "0%";
    in property <string> message: "";
    in property <bool> force-controls: false; // preview/debug only
    in property <bool> undo-reset-enabled: false;
    in property <bool> cursor-blocked: false;
    in property <string> cursor-warning-text: "";
    in property <bool> update-available: false;
    in property <string> update-text: "";

    in property <string> mark-str: "";
    // Frame number of the next pause mark, shown at the bottom-right.
    in property <string> next-mark-str: "";
    // Name of the axis file currently in use, shown in amber at the top-left.
    in property <string> axis-str: "";
    in property <bool> pause-mode: false;
    // Text of the auto-pause lead, e.g. "-2"; empty when pause mode is off.
    in property <string> pause-lead-str: "";

    // ---- reset cover animation (driven from Rust each tick) ----
    // A cyan bar sweeps down from the top to cover the panel, holds, then
    // wipes downward off the bottom. `reset-cover` is the bar's height as a
    // fraction of the panel; `reset-top` is its top-edge offset as a fraction
    // (stays 0 while growing/holding, rises during the downward wipe so the
    // bottom edge stays pinned). Text is centered on the whole panel and fades
    // independently.
    in property <bool> reset-active: false;
    in property <float> reset-cover: 0;   // 0..1 of panel-height
    in property <float> reset-top: 0;     // 0..1 of panel-height
    in property <string> reset-text: "";
    in property <float> reset-text-opacity: 0;

    // ---- outputs ----
    callback start-clicked();
    callback lap-clicked();
    callback open-update();
    callback close-clicked();
    callback settings-clicked();
    callback record-frame-clicked();
    callback pause-mode-clicked();
    callback bg-pressed();
    callback bg-released();

    background: transparent;
    default-font-family: "Bender";
    preferred-width: 210px;
    preferred-height: 82px;

    property <length> panel-height: 56px;
    property <length> toolbar-height: 24px;
    property <bool> running: root.mode == HudMode.running;
    property <bool> show-controls: (hover.has-hover || root.force-controls) && root.running;

    // ---- panel ----
    Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: root.panel-height;
        background: Palette.panel;
        border-width: 1px;
        border-color: root.mode == HudMode.error ? Palette.amber : Palette.hairline;
        animate border-color { duration: 200ms; }
    }

    // top accent hairline ??state colored
    Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: root.cursor-blocked ? root.panel-height / 3 : 2px;
        background: root.mode == HudMode.error ? Palette.amber
            : (root.cursor-blocked ? Palette.amber : (root.running ? Palette.accent : Palette.text-faint));
        opacity: root.cursor-blocked ? 0.96 : 0.9;
        clip: true;
        animate height { duration: 150ms; }
        animate background { duration: 150ms; }

        Text {
            visible: root.cursor-blocked;
            x: 0;
            y: 0;
            width: 100%;
            height: root.panel-height / 3;
            text: root.cursor-warning-text;
            color: #0a0e12;
            font-size: 13px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // ===== RUNNING: timer hero + fixed secondary counter anchor =====
    running-layer := Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: root.panel-height;
        opacity: root.running ? 1 : 0;
        animate opacity { duration: 160ms; }
        visible: running-layer.opacity > 0.01;

        // hero timer
        Text {
            x: 13px;
            y: 0;
            height: 100%;
            text: root.time-str;
            color: Palette.text-primary;
            font-size: 30px;
            font-weight: 700;
            vertical-alignment: center;
        }

        // secondary cluster (cost frame + lap). The slash anchor stays fixed:
        // `frame-str` is right-aligned into the slot before it, and `/total`
        // starts at the same x on every update.
        Rectangle {
            x: 136px;
            y: 12px;
            width: 66px;
            height: 30px;
            Text {
                x: 0;
                y: 0;
                width: 36px;
                height: 22px;
                text: root.frame-str;
                color: Palette.text-primary;
                font-size: 18px;
                font-weight: 700;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            Text {
                x: 36px;
                y: 0;
                width: 30px;
                height: 22px;
                text: root.total-str;
                color: root.cost-negative ? Palette.amber : Palette.text-secondary;
                font-size: 12px;
                font-weight: 500;
                vertical-alignment: bottom;
            }
            Text {
                visible: root.lap-str != "";
                x: 36px;
                y: 19px;
                width: 30px;
                height: 13px;
                text: "+" + root.lap-str;
                color: Palette.amber;
                font-size: 11px;
                font-weight: 600;
                horizontal-alignment: left;
            }
        }

        // current frame + note of that frame (amber, always)
        Text {
            visible: root.mark-str != "";
            x: 13px;
            y: 43px;
            width: 118px;
            height: 12px;
            text: root.mark-str;
            color: Palette.amber;
            font-size: 10px;
            font-weight: 600;
            overflow: elide;
            vertical-alignment: center;
        }

        // next pause mark (bottom-right, mirrored 13px margin, amber)
        Text {
            visible: root.next-mark-str != "";
            x: 131px;
            y: 43px;
            width: 66px;
            height: 12px;
            text: root.next-mark-str;
            color: Palette.amber;
            font-size: 10px;
            font-weight: 600;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    // ===== CALIBRATING: thin progress line + percent =====
    cal-layer := Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: root.panel-height;
        opacity: root.mode == HudMode.calibrating ? 1 : 0;
        animate opacity { duration: 160ms; }
        visible: cal-layer.opacity > 0.01;

        Text {
            text: root.progress-str;
            color: Palette.accent;
            font-size: 20px;
            font-weight: 700;
            x: 13px;
            y: 0;
            height: 100%;
            vertical-alignment: center;
        }
        Rectangle {
            x: 0;
            y: parent.height - 3px;
            width: 100%;
            height: 3px;
            background: #ffffff10;
            Rectangle {
                x: 0; y: 0;
                height: 100%;
                width: parent.width
                    * ((root.mode == HudMode.calibrating ? root.progress : 0) / 100);
                background: Palette.accent;
            }
        }
    }

    // ===== IDLE / PRECAL / ERROR / BOOTING: message =====
    msg-layer := Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: root.panel-height;
        opacity: (root.running || root.mode == HudMode.calibrating) ? 0 : 1;
        animate opacity { duration: 160ms; }
        visible: msg-layer.opacity > 0.01;

        Text {
            x: 12px;
            width: parent.width - 24px;
            height: 100%;
            text: root.message;
            color: root.mode == HudMode.error ? Palette.amber : Palette.text-secondary;
            font-size: 13px;
            font-weight: 500;
            wrap: word-wrap;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // ===== ACTIVE AXIS NAME (amber, top-left, visible in every mode) =====
    // Panel-level on purpose: it used to live inside `running-layer`, so it was
    // invisible whenever no profile was running (idle / prepare-calibration).
    Text {
        visible: root.axis-str != "";
        x: 13px;
        y: 3px;
        width: 180px;
        height: 11px;
        text: root.axis-str;
        color: Palette.amber;
        font-size: 9px;
        font-weight: 600;
        horizontal-alignment: left;
        vertical-alignment: center;
        overflow: elide;
    }

    // ===== AUTO-PAUSE INDICATOR (amber, top-right) =====
    // Shown only while pause mode is armed: "-N" lead frames, text only.
    Text {
        visible: root.pause-mode && root.pause-lead-str != "";
        x: 118px;
        y: 2px;
        width: 79px;
        height: 12px;
        text: root.pause-lead-str;
        color: Palette.amber;
        font-size: 10px;
        font-weight: 600;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    // ===== RESET COVER: cyan bar wipes down over the panel, then wipes off =====
    // No TouchArea ??clicks pass through to whatever is below (the panel / drag
    // surface), so the 0.7s animation never blocks interaction.
    Rectangle {
        visible: root.reset-active;
        x: 0;
        y: root.panel-height * root.reset-top;
        width: 100%;
        height: root.panel-height * root.reset-cover;
        background: Palette.accent;
        clip: true;

        // Text stays centered on the *whole* panel regardless of the bar's
        // current height, so the label reads as "the panel was covered" rather
        // than sliding with the bar edge.
        Text {
            x: 0;
            y: -root.panel-height * root.reset-top;
            width: 100%;
            height: root.panel-height;
            text: root.reset-text;
            color: #0a0e12;
            font-size: 18px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
            opacity: root.reset-text-opacity;
        }
    }

    // ===== background interaction (drag + CTA), control toolbar as child =====
    // As a TouchArea, hover-state propagates to children, so moving onto a
    // button keeps `hover.has-hover` true (no reveal/hide flicker).
    hover := TouchArea {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        clicked => {
            if (root.mode == HudMode.precal) {
                root.start-clicked();
            }
        }
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) {
                root.bg-pressed();
            }
            if (ev.kind == PointerEventKind.up) {
                root.bg-released();
            }
        }

        // Hover-revealed control toolbar (running only). It sits below the
        // primary HUD panel, so it never covers or compresses the readout.
        if (root.update-available): Rectangle {
            width: 48px;
            height: root.toolbar-height;
            x: 4px;
            y: root.panel-height + 2px;
            background: uta.has-hover ? Palette.accent.with-alpha(0.30) : Palette.toolbar;
            border-width: 1px;
            border-color: Palette.accent;
            opacity: root.show-controls ? 1 : 0;
            visible: self.opacity > 0.01;
            animate opacity { duration: 140ms; }
            animate background { duration: 110ms; }
            Text {
                text: root.update-text;
                color: Palette.text-primary;
                font-size: 11px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            uta := TouchArea {
                clicked => { root.open-update(); }
            }
        }

        Rectangle {
            width: 150px;
            height: root.toolbar-height;
            x: parent.width - self.width - 4px;
            y: root.panel-height + 2px;
            background: Palette.toolbar;
            border-width: 1px;
            border-color: Palette.hairline;
            opacity: root.show-controls ? 1 : 0;
            visible: self.opacity > 0.01;
            animate opacity { duration: 140ms; }

            HorizontalLayout {
                padding: 2px;
                spacing: 2px;
                alignment: center;
                IconBtn { icon: Icons.power; danger: true; clicked => { root.close-clicked(); } }
                Chip { width: 40px; label: "设置"; clicked => { root.settings-clicked(); } }
                IconBtn { icon: Icons.flag; strong: root.lap-str != ""; clicked => { root.lap-clicked(); } }
                IconBtn { icon: Icons.bookmark-add; clicked => { root.record-frame-clicked(); } }
                IconBtn { icon: Icons.timer; strong: root.pause-mode; clicked => { root.pause-mode-clicked(); } }
            }
        }
    }
}